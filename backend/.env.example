# Backend (Express)
NODE_ENV=development
PORT=5000

# Required
MONGODB_URI=mongodb://127.0.0.1:27017/med-ai-simulator
JWT_SECRET=replace-with-a-strong-secret-min-64-chars
# Separate secret for refresh tokens (recommended). Falls back to JWT_SECRET if unset.
JWT_REFRESH_SECRET=replace-with-a-different-strong-secret-min-64-chars
# Access token: short-lived (15 minutes recommended for security)
JWT_EXPIRES_IN=15m
# Refresh token: long-lived (7 days)
JWT_REFRESH_EXPIRES_IN=7d
# Cookie signing secret (falls back to JWT_SECRET)
COOKIE_SECRET=replace-with-another-strong-secret

# Comma-separated allowed client origins
CLIENT_ORIGINS=http://localhost:3000,http://localhost:3001,https://medaisimulator.uz,https://admin.medaisimulator.uz,https://manager.medaisimulator.uz

# Comma-separated IPs to permanently block (e.g. known scanners)
BLOCKED_IPS=

# Optional integrations
GOOGLE_CLIENT_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AISHA_API_KEY=
# Muxlisa AI (Uzbek STT/TTS) — https://muxlisa.uz
MUXLISA_API_KEY=
MUXLISA_SPEAKER_MALE=1
MUXLISA_SPEAKER_FEMALE=2

# Email service (for OTP)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Public site URL (used in payment return URLs)
FRONTEND_URL=http://localhost:3000

# Payment gateways — leave blank to keep gateways disabled (manual confirm only).
# Click
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
# Payme
PAYME_MERCHANT_ID=
PAYME_MERCHANT_KEY=

# Telegram — ONE bot handles both payment approval and user support
# (single token, single polling connection). SUPPORT_BOT_TOKEN is preferred;
# if empty, TELEGRAM_BOT_TOKEN is used as a fallback.
SUPPORT_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
# Comma-separated admin Telegram numeric ids (payment + support notifications)
TELEGRAM_ADMIN_IDS=
SUPPORT_FORWARD_CHAT_ID=
# Public admin panel URL used in Telegram message links
ADMIN_PANEL_URL=http://localhost:3000/admin

# Subscription prices (so'm)
PRICE_MONTHLY=60000
PRICE_YEARLY=550000
PRICE_YEARLY_OLD=720000

# Referral reward per successfully referred sign-up
REFERRAL_BONUS=1000
REFERRAL_POINTS=5

# DigitalOcean Spaces (S3-compatible) — file uploads.
# Leave blank to fall back to local disk storage (backend/public/uploads).
SPACES_KEY=
SPACES_SECRET=
SPACES_REGION=sfo3
SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com
SPACES_BUCKET=med-ai-simulator
SPACES_PUBLIC_URL=https://med-ai-simulator.sfo3.digitaloceanspaces.com
